# ---------------------------------------------------------------------------
msgid "申请已提交"
msgstr "Application Submitted"

msgid "我们已收到你的领养申请，救助站会尽快与你联系。"
msgstr "We have received your adoption application. The shelter will contact you as soon as possible."

msgid "申请编号"
msgstr "Reference"

msgid "申请人"
msgstr "Applicant"

msgid "申请的动物"
msgstr "Animal applied for"

msgid "电子邮箱"
msgstr "Email"

msgid "最佳联系方式"
msgstr "Best way to reach you"

msgid "提交时间"
msgstr "Submitted at"

msgid "未填写"
msgstr "Not provided"

msgid "你希望沟通的话题"
msgstr "Topics you would like to discuss"

msgid "你感兴趣的额外服务"
msgstr "Additional services you are interested in"

msgid "接下来的流程"
msgstr "What happens next"

msgid "救助站会在 3 个工作日内通过你选择的方式联系你。"
msgstr "The shelter will contact you within 3 working days using the method you chose."

msgid "双方沟通养护细节，并确认居住环境是否符合要求。"
msgstr "We will discuss care details and confirm whether your home environment meets the requirements."

msgid "签署领养协议，约定时间到救助站与狗狗见面。"
msgstr "Sign the adoption agreement and arrange a time to meet the dog at the shelter."

msgid "完成交接，进入回访期，我们会在 1 个月内跟进适应情况。"
msgstr "Complete the handover and enter the follow-up period — we will check in on how things are going within one month."

msgid "查看申请记录"
msgstr "View applications"

msgid "继续浏览待领养狗狗"
msgstr "Keep browsing dogs"

msgid "领养申请记录"
msgstr "Adoption Applications"

msgid "这里展示本站收到的全部领养申请，可用于查看已提交记录。"
msgstr "All adoption applications received by this site are listed here so you can review what has been submitted."

msgid "共 %(total)s 条申请记录"
msgstr "%(total)s application(s) in total"

msgid "联系方式"
msgstr "Contact"

msgid "操作"
msgstr "Actions"

msgid "待救助站推荐"
msgstr "To be recommended by the shelter"

msgid "查看回执"
msgstr "View receipt"

msgid "申请记录分页"
msgstr "Application list pagination"

msgid "还没有收到领养申请"
msgstr "No adoption applications yet"

msgid "前往领养狗狗页面挑选一只狗狗并提交申请，记录会显示在这里。"
msgstr "Pick a dog on the Adopt a Dog page and submit an application — it will show up here."

msgid "去挑选狗狗"
msgstr "Choose a dog"


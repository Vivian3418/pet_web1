# ---------------------------------------------------------------------------
msgid "label"
msgstr "label"

msgid "让每一个生命都被温柔以待"
msgstr "Let every life be met with gentleness"

msgid "跳到主要内容"
msgstr "Skip to main content"

msgid "站点主导航"
msgstr "Site main navigation"

msgid "展开导航菜单"
msgstr "Toggle navigation menu"

msgid "面包屑导航"
msgstr "Breadcrumb"

msgid "首页"
msgstr "Home"

msgid "领养宠物"
msgstr "Adopt a Pet"

msgid "动物保护"
msgstr "Animal Protection"

msgid "参与公益"
msgstr "Get Involved"

msgid "公益演示站点 · 本站内容仅用于功能演示"
msgstr "Non-profit demo site · content is for demonstration purposes only"

msgid "%(site)s —— 动物保护、宠物救助与宠物领养公益平台"
msgstr "%(site)s — a non-profit platform for animal protection, pet rescue and pet adoption"

msgid "%(slogan)s。我们致力于动物保护、宠物救助与宠物领养，让每一次相遇都成为温暖的开始。"
msgstr "%(slogan)s. We work on animal protection, pet rescue and pet adoption, so that every encounter becomes a warm new beginning."

# ---------------------------------------------------------------------------
# 通用占位页与错误页
# ---------------------------------------------------------------------------
msgid "页面未找到"
msgstr "Page Not Found"

msgid "您访问的页面不存在，请通过顶部导航返回。"
msgstr "The page you requested does not exist. Please use the navigation above to continue."

msgid "服务暂时不可用"
msgstr "Service Temporarily Unavailable"

msgid "服务器开小差了，请稍后再试。"
msgstr "Something went wrong on our side. Please try again later."

msgid "本页面正在建设中，敬请期待。"
msgstr "This page is under construction. Stay tuned."

msgid "当前页面仅展示页面名称，后续将在此填充具体的公益内容与交互功能。"
msgstr "This page currently only shows its title; detailed content and interactions will be added later."

# ---------------------------------------------------------------------------
# 首页
# ---------------------------------------------------------------------------
msgid "动物保护 · 宠物救助 · 宠物领养"
msgstr "Animal Protection · Pet Rescue · Pet Adoption"

msgid "让每一个生命"
msgstr "Let every life"

msgid "都被"
msgstr "be met with"

msgid "温柔以待"
msgstr "gentleness"

msgid "%(site)s 连接流浪动物、救助机构与爱心家庭，用透明可信的领养机制，让等待被看见，让陪伴有归处。"
msgstr "%(site)s connects stray animals, rescue organisations and loving families. With a transparent and trustworthy adoption process, we make sure every waiting animal is seen and every companion finds a home."

msgid "了解领养流程"
msgstr "Learn About Adoption"

msgid "成功领养"
msgstr "Successful adoptions"

msgid "合作救助站"
msgstr "Partner shelters"

msgid "注册志愿者"
msgstr "Registered volunteers"

msgid "志愿者与待领养的狗狗互动"
msgstr "A volunteer interacting with a dog waiting to be adopted"

msgid "每一次领养，都是一次生命的重启"
msgstr "Every adoption is a fresh start for a life"

msgid "从提交申请到接它回家，只需四步。"
msgstr "Four simple steps from application to bringing your new friend home."

msgid "在线提交申请"
msgstr "Apply online"

msgid "填写领养申请表，说明居住环境、家庭成员与养宠经验。"
msgstr "Complete the adoption application form describing your home, household members and pet experience."

msgid "救助站联系沟通"
msgstr "Talk with the shelter"

msgid "工作人员会在 3 个工作日内联系你，沟通养护细节与双方期待。"
msgstr "Our staff will contact you within 3 working days to talk through care details and expectations."

msgid "见面与匹配"
msgstr "Meet and match"

msgid "到救助站与狗狗见面，确认性格与生活方式是否契合。"
msgstr "Visit the shelter to meet the dog and see whether personalities and lifestyles fit."

msgid "签署协议与交接"
msgstr "Sign and take home"

msgid "签署领养协议并接它回家，1 个月内我们会回访跟进。"
msgstr "Sign the adoption agreement and bring your new friend home — we will follow up within one month."

msgid "救助故事"
msgstr "Rescue Stories"

msgid "每一个故事都始于一次救助，正在等待一个结局。"
msgstr "Every story begins with a rescue and is waiting for its ending."

msgid "救助故事列表"
msgstr "Rescue stories list"

msgid "救助人与 %(name)s 的合照"
msgstr "The rescuer with %(name)s"

msgid "左右滑动查看更多故事"
msgstr "Scroll sideways to see more stories"

msgid "你的一个小小行动，就是它的一生"
msgstr "One small act from you means a whole life to them"

msgid "加入 %(site)s，用领养代替购买，用陪伴代替遗弃。"
msgstr "Join %(site)s — adopt instead of buying, and accompany instead of abandoning."

msgid "我要捐赠"
msgstr "Donate Now"

msgid "申请寄养"
msgstr "Apply to Foster"

# ---------------------------------------------------------------------------
# 占位子页面：领养宠物
# ---------------------------------------------------------------------------
msgid "领养狗狗"
msgstr "Adopt a Dog"

msgid "领养猫咪"
msgstr "Adopt a Cat"

msgid "这里将展示等待领养的猫咪信息与领养条件。"
msgstr "Adoptable cats and adoption requirements will be listed here."

msgid "其他宠物"
msgstr "Other Pets"

msgid "这里将展示兔子、鸟类等小动物的领养信息。"
msgstr "Adoption information for rabbits, birds and other small animals will be listed here."

msgid "领养流程"
msgstr "Adoption Process"

msgid "这里将介绍从申请、审核到交接的完整领养流程。"
msgstr "This page will explain the full adoption process, from application and review to handover."

# ---------------------------------------------------------------------------
# 占位子页面：动物保护
# ---------------------------------------------------------------------------
msgid "动物福利"
msgstr "Animal Welfare"

msgid "这里将介绍动物福利五大自由与相关公益倡议。"
msgstr "The Five Freedoms of animal welfare and related initiatives will be introduced here."

msgid "反动物虐待"
msgstr "Against Animal Cruelty"

msgid "这里将介绍反虐待动物知识科普与举报求助渠道。"
msgstr "Knowledge about animal cruelty prevention and how to report abuse will be introduced here."

msgid "灾害动物救助"
msgstr "Disaster Animal Rescue"

msgid "这里将介绍自然灾害中的动物紧急救助行动。"
msgstr "Emergency rescue actions for animals in natural disasters will be introduced here."

# ---------------------------------------------------------------------------
# 占位子页面：参与公益
# ---------------------------------------------------------------------------
msgid "成为志愿者"
msgstr "Become a Volunteer"

msgid "这里将介绍志愿者招募条件与报名方式。"
msgstr "Volunteer requirements and sign-up details will be introduced here."

msgid "公益活动"
msgstr "Charity Events"

msgid "这里将展示近期公益活动安排与往期回顾。"
msgstr "Upcoming charity events and past highlights will be shown here."

msgid "捐赠"
msgstr "Donate"

msgid "这里将说明捐赠用途、物资清单与捐赠渠道。"
msgstr "How donations are used, the supplies needed and the donation channels will be explained here."

msgid "寄养宠物"
msgstr "Foster a Pet"

msgid "这里将介绍临时寄养家庭的申请与支持方案。"
msgstr "How to apply to become a foster home, and the support provided, will be introduced here."

